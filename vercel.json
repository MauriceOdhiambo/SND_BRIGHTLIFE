{
  "functions": {
    "api/server.js": {
      "maxDuration": 60
    },
    "api/cron/[job].js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/monthly-summary",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/overdue-loans",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/pending-approvals",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/pending-approvals",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
